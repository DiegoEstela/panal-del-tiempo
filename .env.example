# Copiá este archivo como .env.local y completá los valores de tu proyecto
# de Firebase (Configuración del proyecto > Tus apps > SDK setup and configuration).
# Mientras estas variables no estén completas, la app funciona en modo demo
# local (localStorage) sin necesitar Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
